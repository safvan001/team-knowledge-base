# Optional. Without it the system runs fully, answering from a deterministic
# template over the same retrieved context.
GEMINI_API_KEY=
# Gemini 2.5 models are retired for new API keys. Use a 3.x model.
GEMINI_MODEL=gemini-3.6-flash

# Optional Django overrides.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# How far the retrieval layer walks out from the entities a question names.
RETRIEVAL_MAX_HOPS=2
